+/**
+ * A deployment may mount a global multimodal vision channel (for example the
+ * out-of-tree `dsh-multimodal` profile plugin) that gives a text-only model
+ * image understanding indirectly: it registers a `vision` tool and replaces
+ * image blocks with a text note at the llm/stream boundary, directing the
+ * model to call `vision`. While that channel is active, admitting an image
+ * prompt for a text-only model is safe — the image never reaches the model
+ * directly — and is the only way a user can paste an image for the vision
+ * tool to read. Such a plugin exposes its state on `ctx` under the
+ * `globalMultimodal` key with a `visionEnabled()` predicate; when the key is
+ * absent (no plugin mounted), this returns false and the modality guard below
+ * behaves exactly as before.
+ */
+function multimodalVisionActive(ctx: Context): boolean {
+  const multimodal = ctx.get('globalMultimodal')
+  return typeof multimodal?.visionEnabled === 'function' && multimodal.visionEnabled() === true
+}
